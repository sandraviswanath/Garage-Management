<odoo>
  <record id="module_category_workshop" model="ir.module.category"><field name="name">Workshop Hub</field></record>
  <record id="group_technician" model="res.groups">
    <field name="name">Technician</field><field name="category_id" ref="module_category_workshop"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_receptionist" model="res.groups"><field name="name">Receptionist</field><field name="category_id" ref="module_category_workshop"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
  <record id="group_accountant" model="res.groups"><field name="name">Workshop Accountant</field><field name="category_id" ref="module_category_workshop"/><field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_user'))]"/></record>
  <record id="group_manager" model="res.groups">
    <field name="name">Workshop Manager</field><field name="category_id" ref="module_category_workshop"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_manager')), (4, ref('stock.group_stock_manager')), (4, ref('purchase.group_purchase_manager')), (4, ref('account.group_account_manager'))]"/>
    <field name="users" eval="[(4, ref('base.user_admin'))]"/>
  </record>
</odoo>
