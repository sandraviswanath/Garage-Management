{
  "expo": {
    "name": "Workshop Hub",
    "slug": "workshop-technician",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.example.workshophub.technician",
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.workshophub.technician"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose repair photos to attach to your assigned workshop job.",
          "cameraPermission": "Take photos of vehicle repairs for your assigned job.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
